generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(80)
  passwordHash String    @db.VarChar(255)
  birthDate    DateTime? @db.Date
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  cards Card[]
}

model Card {
  id            String  @id @default(uuid())
  name          String  @db.VarChar(80)
  description   String? @db.VarChar(500)
  favoriteColor String? @db.VarChar(9)
  avatarUrl     String? @default("")
  handle        String? @db.VarChar(30)
  location      String? @db.VarChar(40)

  template Template
  layout   Layout

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categories CardCategory[]

  @@index([userId])
}

model CardCategory {
  id    String       @id @default(uuid())
  name  String       @db.VarChar(40)
  type  FavoriteType
  order Int

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  favorites Favorite[]

  @@unique([cardId, order])
  @@unique([cardId, type])
}

model Favorite {
  id         String @id @default(uuid())
  title      String @db.VarChar(200)
  imageUrl   String
  externalId String @db.VarChar(64)
  order      Int

  categoryId String
  category   CardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, order])
}

enum Template {
  DARK
  LIGHT
  NEON
  MINIMAL
  PRESS
  COMIC
  FUTURE
  VINTAGE
  GLASS
  VECTOR
  RETRO
  PIXEL
  Y2K
  SWISS
  GRAFFITI
}

enum Layout {
  VERTICAL
  HORIZONTAL
  SQUARE
}

enum FavoriteType {
  MOVIE
  MUSIC
  GAME
  SERIES
  SPORT
  BOOK
  ARTIST
  ANIME
}
