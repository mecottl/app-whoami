# Copia este archivo a .env y rellena los valores. NO commitees .env.

# Postgres.
#  - Local (Docker):   postgresql://USER:PASSWORD@localhost:5432/whoami
#  - Producción:        cadena "Session pooler" de Supabase (puerto 5432),
#                       con ?sslmode=require . Ver DEPLOY.md.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/whoami"

# Secreto para firmar JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto"

# The Movie Database - https://www.themoviedb.org/settings/api
# Cubre PELÍCULAS (/search/movie) y SERIES (/search/tv)
TMDB_API_KEY=

# RAWG - juegos. Key gratis en https://rawg.io/apikey
# Sin ella, la búsqueda de la categoría GAME responde 503.
RAWG_API_KEY=

# TheSportsDB - deportes (equipos). "3" es la key pública de pruebas.
# Tu propia key: https://www.thesportsdb.com/api.php
SPORTSDB_API_KEY=3

PORT=3000
# En producción: dominio(s) del frontend en Vercel, separados por coma.
CORS_ORIGIN=http://localhost:4200
